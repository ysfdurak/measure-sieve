// Cloudflare Workers: tarayıcı sürümünü (web/) statik site olarak yayınlar.
// Sunucu kodu yoktur; yalnız statik dosyalar sunulur. Depo Cloudflare'e bağlandığında
// main dalına her gönderimde otomatik yayın yapılır.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "measure-sieve",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    "not_found_handling": "404-page"
  },
  // Ana dal dışındaki dallarda Cloudflare "wrangler preview" çalıştırır; bu blok olmadan önizleme derlemesi düşer.
  "previews": {},
  "routes": [
    { "pattern": "measure-sieve.ysfdurak.com", "custom_domain": true }
  ]
}
